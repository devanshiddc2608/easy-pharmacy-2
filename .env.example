# Easy Pharmacy 2.0 — Environment Variables
# Copy this file, rename to .env, and fill in your values
# NEVER commit the actual .env file to GitHub — add it to .gitignore

# Get your Groq API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Generate a random secret key for Flask sessions
# You can run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_random_secret_key_here
